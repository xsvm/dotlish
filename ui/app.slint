import { Button, ScrollView } from "std-widgets.slint";

export { SettingsWindow, HotkeyRow } from "settings.slint";

export struct IssueItem {
    message: string,
    original: string,
    candidates: [string],
    // -1 表示保留原文
    picked: int,
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    border-radius: 5px;
    background: on ? #2f6fde : #f1f2f5;
    min-width: t.preferred-width + 20px;
    height: 24px;
    t := Text {
        text: root.label;
        color: root.on ? white : #1d1f24;
        font-size: 13px;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Popup inherits Window {
    // loading | check | translate | dict | error
    in property <string> mode: "loading";
    in property <string> heading;
    in property <string> note;
    in property <string> service;
    in property <string> source-text;
    in property <string> result-text;
    in property <[IssueItem]> issues;
    // 词典：音标、逐条释义、词形变化
    in property <string> phonetic;
    in property <[string]> senses;
    in property <string> extra;
    in property <image> window-icon;

    callback dismiss();
    callback copy-result();
    callback replace();
    callback pick(int, int);

    no-frame: true;
    always-on-top: true;
    title: "select-assist";
    icon: root.window-icon;
    background: #fbfbfc;
    default-font-size: 14px;

    // 纠错有问题时可修正，翻译总可替换
    property <bool> can-replace: root.mode == "translate" || (root.mode == "check" && root.issues.length > 0);

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            if (event.text == Key.Return && event.modifiers.control && root.can-replace) {
                root.replace();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 12px;
            spacing: 8px;

            // 标题栏
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.heading;
                    font-weight: 600;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.note;
                    color: #737a87;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 6px;
                    background: close-area.has-hover ? #f1f2f5 : transparent;
                    // 用矢量画叉，不依赖字体里有没有 ✕ 这个字形
                    Path {
                        width: 10px;
                        height: 10px;
                        viewbox-width: 10;
                        viewbox-height: 10;
                        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                        stroke: close-area.has-hover ? #1d1f24 : #737a87;
                        stroke-width: 1.5px;
                    }
                    close-area := TouchArea { clicked => { root.dismiss(); } }
                }
            }

            // 内容
            Rectangle {
                vertical-stretch: 1;

                if root.mode == "loading": Text {
                    text: "正在处理…";
                    color: #737a87;
                    x: 0;
                    y: 0;
                }

                if root.mode == "error": Text {
                    text: root.result-text;
                    color: #d4473b;
                    wrap: word-wrap;
                    x: 0;
                    y: 0;
                    width: parent.width;
                }

                if root.mode == "check": ScrollView {
                    VerticalLayout {
                        spacing: 10px;
                        padding-right: 16px;
                        Text {
                            text: root.result-text;
                            font-size: 15px;
                            wrap: word-wrap;
                        }
                        for issue[i] in root.issues: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "“" + issue.original + "” · " + issue.message;
                                color: #737a87;
                                font-size: 12.5px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for c[j] in issue.candidates: Chip {
                                    label: c;
                                    on: j == issue.picked;
                                    clicked => { root.pick(i, j); }
                                }
                                Chip {
                                    label: "保留原文";
                                    on: issue.picked == -1;
                                    clicked => { root.pick(i, -1); }
                                }
                            }
                        }
                    }
                }

                if root.mode == "translate": ScrollView {
                    HorizontalLayout {
                        spacing: 24px;
                        padding-right: 16px;
                        alignment: start;
                        Text {
                            text: root.source-text;
                            color: #737a87;
                            wrap: word-wrap;
                            vertical-alignment: top;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.result-text;
                            font-size: 15px;
                            wrap: word-wrap;
                            vertical-alignment: top;
                            horizontal-stretch: 1;
                        }
                    }
                }

                if root.mode == "dict": ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: 8px;
                        padding-right: 16px;
                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;
                            Text {
                                text: root.source-text;
                                font-size: 26px;
                                font-weight: 600;
                            }
                            Text {
                                text: root.phonetic;
                                color: #737a87;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                        for sense in root.senses: Text {
                            text: sense;
                            font-size: 15px;
                            wrap: word-wrap;
                        }
                        if root.extra != "": Text {
                            text: root.extra;
                            color: #737a87;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // 底栏
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.service;
                    color: #737a87;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.mode != "loading" && root.mode != "error": Button {
                    text: "复制";
                    clicked => { root.copy-result(); }
                }
                if root.can-replace: Button {
                    text: root.mode == "check" ? "修正" : "替换";
                    primary: true;
                    clicked => { root.replace(); }
                }
            }
        }
    }

    init => { keys.focus(); }
}
