import { Button, ScrollView } from "std-widgets.slint";

export { SettingsWindow, HotkeyRow } from "settings.slint";

export struct IssueItem {
    message: string,
    original: string,
    candidates: [string],
    // -1 表示保留原文
    picked: int,
}

/// 一个词条：单词、音标、逐条释义、词形变化。
export struct DictData {
    word: string,
    phonetic: string,
    senses: [string],
    forms: string,
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    border-radius: 5px;
    background: on ? #2f6fde : #f1f2f5;
    min-width: t.preferred-width + 20px;
    height: 24px;
    t := Text {
        text: root.label;
        color: root.on ? white : #1d1f24;
        font-size: 13px;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component CloseButton inherits Rectangle {
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: area.has-hover ? #0000000d : transparent;
    // 用矢量画叉，不依赖字体里有没有 ✕ 这个字形
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
        stroke: area.has-hover ? #1d1f24 : #8a909c;
        stroke-width: 1.5px;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

/// 词条。compact 用于翻译页右侧的小面板。
component DictView inherits VerticalLayout {
    in property <DictData> data;
    in property <bool> compact;
    /// 查询中或出错时显示在单词下面
    in property <string> note;
    alignment: start;
    spacing: root.compact ? 6px : 10px;

    HorizontalLayout {
        spacing: 14px;
        alignment: start;
        Text {
            text: root.data.word;
            font-size: root.compact ? 19px : 26px;
            font-weight: 600;
            color: #16181d;
            wrap: word-wrap;
        }
        if !root.compact: Text {
            text: root.data.phonetic;
            color: #8a909c;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    if root.compact && root.data.phonetic != "": Text {
        text: root.data.phonetic;
        color: #8a909c;
        font-size: 12px;
        wrap: word-wrap;
    }
    if root.note != "": Text {
        text: root.note;
        color: #8a909c;
        font-size: 13px;
        wrap: word-wrap;
    }
    for sense in root.data.senses: Text {
        text: sense;
        color: #2a2d34;
        font-size: root.compact ? 13.5px : 15px;
        line-height-factor: 1.25;
        wrap: word-wrap;
    }
    if root.data.forms != "": Text {
        text: root.data.forms;
        color: #8a909c;
        font-size: 12.5px;
        line-height-factor: 1.2;
        wrap: word-wrap;
    }
}

/// 可选中的只读文字。点单词或选中单词时上报选区（UTF-8 字节偏移）。
component SelectableText inherits TextInput {
    callback selection-changed(int, int);
    callback key(KeyEvent) -> EventResult;
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    text-cursor-width: 0px;
    selection-background-color: #2f6fde29;
    selection-foreground-color: #16181d;
    // 只响应用户点击：程序设置文字时光标也会移动，那时还没有焦点
    cursor-position-changed => {
        if (self.has-focus) {
            root.selection-changed(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
        }
    }
    key-pressed(event) => { return root.key(event); }
}

export component Popup inherits Window {
    // loading | check | translate | dict | error
    in property <string> mode: "loading";
    in property <string> heading;
    in property <string> note;
    in property <string> service;
    in property <string> source-text;
    in property <string> result-text;
    in property <[IssueItem]> issues;
    in property <DictData> dict;
    // 翻译页右侧的单词释义
    in property <bool> word-open;
    in property <DictData> word-dict;
    in property <string> word-note;
    in property <image> window-icon;

    callback dismiss();
    callback copy-result();
    callback replace();
    callback pick(int, int);
    /// 翻译页选区变化：pane 0 是原文、1 是译文
    callback selection-changed(int, int, int);
    callback close-word();

    /// 每次新请求把焦点还给弹窗本身，文字框重新有焦点只能靠用户点击
    public function reset-focus() {
        keys.focus();
    }

    /// 高亮点中的单词
    public function select-word(pane: int, start: int, end: int) {
        if (pane == 0) {
            source.set-selection-offsets(start, end);
        } else {
            result.set-selection-offsets(start, end);
        }
    }

    no-frame: true;
    always-on-top: true;
    title: "select-assist";
    icon: root.window-icon;
    background: transparent;
    default-font-size: 14px;

    // 纠错有问题时可修正，翻译总可替换
    property <bool> can-replace: root.mode == "translate" || (root.mode == "check" && root.issues.length > 0);

    function handle-key(event: KeyEvent) -> EventResult {
        if (event.text == Key.Escape) {
            root.dismiss();
            return EventResult.accept;
        }
        if (event.text == Key.Return && event.modifiers.control && root.can-replace) {
            root.replace();
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    // 窗口本身透明，内容画在圆角面板上
    Rectangle {
        border-radius: 12px;
        background: #fbfbfc;
        border-width: 1px;
        border-color: #0000001f;
        clip: true;

        keys := FocusScope {
            key-pressed(event) => { return root.handle-key(event); }

            VerticalLayout {
                padding-left: 20px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 12px;
                spacing: 8px;

                // 标题栏
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.heading;
                        font-weight: 600;
                        font-size: 13px;
                        color: #1d1f24;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.note;
                        color: #8a909c;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    CloseButton { clicked => { root.dismiss(); } }
                }

                // 内容
                Rectangle {
                    vertical-stretch: 1;

                    if root.mode == "loading": Text {
                        text: "正在处理…";
                        color: #8a909c;
                        x: 0;
                        y: 0;
                    }

                    if root.mode == "error": Text {
                        text: root.result-text;
                        color: #d4473b;
                        wrap: word-wrap;
                        x: 0;
                        y: 0;
                        width: parent.width;
                    }

                    if root.mode == "check": ScrollView {
                        VerticalLayout {
                            spacing: 10px;
                            padding-right: 16px;
                            Text {
                                text: root.result-text;
                                font-size: 15px;
                                line-height-factor: 1.25;
                                wrap: word-wrap;
                            }
                            for issue[i] in root.issues: VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "“" + issue.original + "” · " + issue.message;
                                    color: #737a87;
                                    font-size: 12.5px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    for c[j] in issue.candidates: Chip {
                                        label: c;
                                        on: j == issue.picked;
                                        clicked => { root.pick(i, j); }
                                    }
                                    Chip {
                                        label: "保留原文";
                                        on: issue.picked == -1;
                                        clicked => { root.pick(i, -1); }
                                    }
                                }
                            }
                        }
                    }

                    // 不用 if：select-word 要能找到里面的两个文字框
                    HorizontalLayout {
                        visible: root.mode == "translate";
                        spacing: 14px;
                        ScrollView {
                            horizontal-stretch: 3;
                            VerticalLayout {
                                alignment: start;
                                spacing: 12px;
                                padding-right: 14px;
                                padding-top: 4px;
                                source := SelectableText {
                                    text: root.source-text;
                                    color: #6b7180;
                                    font-size: 14px;
                                    line-height-factor: 1.25;
                                    selection-changed(a, c) => { root.selection-changed(0, a, c); }
                                    key(event) => { return root.handle-key(event); }
                                }
                                Rectangle {
                                    height: 1px;
                                    background: #0000000d;
                                }
                                result := SelectableText {
                                    text: root.result-text;
                                    color: #16181d;
                                    font-size: 19px;
                                    line-height-factor: 1.3;
                                    selection-changed(a, c) => { root.selection-changed(1, a, c); }
                                    key(event) => { return root.handle-key(event); }
                                }
                            }
                        }
                        if root.word-open: Rectangle {
                            horizontal-stretch: 2;
                            min-width: 200px;
                            border-radius: 10px;
                            background: #f2f3f6;
                            ScrollView {
                                DictView {
                                    padding: 14px;
                                    padding-right: 30px;
                                    compact: true;
                                    data: root.word-dict;
                                    note: root.word-note;
                                }
                            }
                            CloseButton {
                                x: parent.width - self.width - 6px;
                                y: 6px;
                                clicked => { root.close-word(); }
                            }
                        }
                    }

                    if root.mode == "dict": ScrollView {
                        DictView {
                            padding-right: 16px;
                            data: root.dict;
                        }
                    }
                }

                // 底栏
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.mode == "translate" && !root.word-open ? root.service + " · 点击单词查看释义" : root.service;
                        color: #8a909c;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.mode != "loading" && root.mode != "error": Button {
                        text: "复制";
                        clicked => { root.copy-result(); }
                    }
                    if root.can-replace: Button {
                        text: root.mode == "check" ? "修正" : "替换";
                        primary: true;
                        clicked => { root.replace(); }
                    }
                }
            }
        }
    }

    init => { keys.focus(); }
}
